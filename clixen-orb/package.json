{
  "name": "clixen-orb",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "dev": "tauri dev",
    "build": "tauri build",
    "typecheck": "tsc -p . --noEmit",
    "typecheck:js": "tsc -p . --noEmit --checkJs",
    "test:web": "node --test test/*.test.js",
    "test:ui": "${PYTHON:-../.venv/bin/python} test/orb_ui.py",
    "release": "bash scripts/release.sh",
    "test:e2e": "wdio run wdio.conf.js",
    "build:e2e": "tauri build --debug --bundles app --config src-tauri/tauri.e2e.conf.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@wdio/cli": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "@wdio/tauri-plugin": "^1.5.0",
    "@wdio/tauri-service": "^1.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "caveman": "^0.1.6",
    "ponytail": "^1.0.57"
  }
}
