# =============================================================================
# Clixen — environment template
# =============================================================================
# Copy this file to `.env` (same directory) and fill in the values you need.
#   cp .env.example .env
# Nothing here is required to get the web UI running locally — the app works
# with zero API keys. Each section below only lights up the feature it's for.
#
# Secrets live ONLY in tools-harness/.env. Never commit .env, and never put
# credentials in project-root .env.local (that's for the Next.js web app).

# ---------------------------------------------------------------------------
# REQUIRED — core messaging
# ---------------------------------------------------------------------------
# Telegram bot (powers the Telegram interface + scheduled automations that send
#   Telegram messages). Create a bot with @BotFather, get the token.
#   https://core.telegram.org/bots
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id — used to gate the owner-only commands.
#   Message @userinfobot or @getmyid_bot to find it.
TELEGRAM_OWNER_CHAT_ID=

# ---------------------------------------------------------------------------
# REQUIRED — cloud LLM (main agent defaults to DeepSeek via direct API)
# ---------------------------------------------------------------------------
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# https://openrouter.ai/keys — fallback provider (Claude Haiku fallback, vision).
#   Your key may be provider-restricted; DeepSeek models 404 through OpenRouter
#   unless deepseek is in the allowed-providers list.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Web search
# ---------------------------------------------------------------------------
# SearXNG (self-hosted, recommended — zero API cost). Default http://localhost:8888
# SEARXNG_URL=http://localhost:8888
# Tavily (optional search backend) — https://app.tavily.com/
TAVILY_API_KEY=
# Brave Search API (optional) — https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Exa (optional, academic/structured search) — https://exa.ai/
EXA_API_KEY=
# Firecrawl (optional, web scraping) — https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# ---------------------------------------------------------------------------
# TTS / STT models (local files, all under <repo>/models/)
# ---------------------------------------------------------------------------
# Optional — the app falls back to <repo>/models/ by default.
# WHISPER_MODEL_PATH=models/ggml-base.bin
# KOKORO_ONNX_PATH=models/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=models/voices-v1.0.bin
# ONNX_PROVIDER=CPUExecutionProvider
# TTS daemon hardening (optional): shared token + bind host. ringback's docker
#   container needs the 0.0.0.0 bind; set 127.0.0.1 if you don't use ringback.
# KOKORO_AUTH_TOKEN=
# KOKORO_BIND_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Local Ollama
# ---------------------------------------------------------------------------
# Default http://localhost:11434. Point at a remote/other-host Ollama if needed.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_HOST=http://localhost:11434
# Default model used for local (non-cloud) calls. Overrides the built-in
#   gemma4:12b-mlx default. See scripts/profile_hardware.py.
# OLLAMA_DEFAULT_MODEL=gemma4:12b-mlx
# OLLAMA_KV_CACHE_TYPE=q8_0
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_API_KEY=

# ---------------------------------------------------------------------------
# Google APIs (Gmail / Calendar / Docs / Sheets / Tasks)
# ---------------------------------------------------------------------------
# OAuth client creds + token. Defaults to ./google-mcp/{credentials,token}.json.
# Create an OAuth client here:
#   https://console.cloud.google.com/apis/credentials
# GOOGLE_CREDENTIALS_PATH=./google-mcp/credentials.json
# GOOGLE_TOKEN_PATH=./google-mcp/token.json
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Messaging: WhatsApp bot (optional)
# ---------------------------------------------------------------------------
# Both the bridge (Baileys, :9235) and bot (:9236) now bind loopback. When
# WHATSAPP_BOT_TOKEN is set, /webhook + /send require it (bridge forwards it).
# WHATSAPP_BOT_TOKEN=
# WHATSAPP_BRIDGE_URL=http://localhost:9235
# WHATSAPP_BOT_PORT=9236
# WHATSAPP_BRIDGE_PORT=9235

# ---------------------------------------------------------------------------
# Automations / email jobs — REPLACE THE OWNER'S DEFAULTS
# ---------------------------------------------------------------------------
# The jobs below used to default to the author's personal addresses. Set these
# or the automations will email/notify the wrong inboxes.
# Email address tech briefings and daily summaries are sent to.
# TECH_BRIEF_EMAIL=
# Senders the inbox/attachment monitors watch (comma-separated).
# WATCHED_SENDERS=
# Default sender for imessage automation sends.
# IMESSAGE_DEFAULT_TARGET=
# CLIXEN_EMAIL=owner@local.dev

# ---------------------------------------------------------------------------
# Auth (web UI local account)
# ---------------------------------------------------------------------------
# Sets/keeps the owner account in sync on startup. Without these, the account
#   is created unconfigured (any first-run register claims it).
# DEV_EMAIL=
# DEV_PASSWORD=
# G4L_DEV_MODE=0          # 1 skips auth on /chat/local-agent/* (dev only)

# ---------------------------------------------------------------------------
# Budget / cost guard
# ---------------------------------------------------------------------------
# CLOUD_DAILY_TOKEN_BUDGET=2000000

# ---------------------------------------------------------------------------
# Voice (Brabble / ringback SIP calls) — optional
# ---------------------------------------------------------------------------
# BRABBLE_AUDIO_PATH=
# VOICE_SIP_ID=
# VOICE_SIP_USER=
# VOICE_SIP_PASS=
# VOICE_SIP_PROXY=
# VOICE_STUN=
# RINGBACK_CALL_COOLDOWN_SECONDS=900

# ---------------------------------------------------------------------------
# Miscellaneous integrations (optional)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_REAL_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# RAPIDAPI_KEY=
# RESEND_SMTP_PASS=
# UNPAYWALL_EMAIL=
# SUDO_PASSWORD=
# AGENTMAIL_BASE_URL=http://localhost:3100/v0
# AGENTMAIL_API_KEY=
# NTFY_URL=
# NTFY_TOKEN=
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
# NCBI_API_KEY=
# PUBLIC_BASE_URL=http://localhost:9234
# TELEGRAM_BASE_URL=https://api.telegram.org/bot
# TELEGRAM_PROXY_URL=
# USER_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Testing-only / internal
# ---------------------------------------------------------------------------
# G4L_TEST_EMAIL=
# G4L_TEST_PASSWORD=
